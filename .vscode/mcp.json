{
    "servers": {
        "autocad-mcp": {
            "type": "stdio",
            "command": "dotnet",
            "args": [
                "${workspaceFolder}/plugins/AutoCAD_MCP_Server/bin/Release/net10.0/AutoCAD_MCP_Server.dll"
            ]
        },
        "graphify": {
            "type": "stdio",
            "command": "uv",
            "args": [
                "run",
                "--with",
                "graphifyy",
                "--with",
                "mcp",
                "-m",
                "graphify.serve",
                "${workspaceFolder}/graphify-out/graph.json"
            ]
        },
        "powerbi": {
            "type": "stdio",
            "command": "npx",
            "args": [
                "-y",
                "@microsoft/powerbi-modeling-mcp@latest",
                "--start",
                "--accept-eula"
            ],
            "env": {
                "PBI_MODELING_MCP_ACCEPT_EULA": "true"
            }
        }
    }
}
